generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }

model User { id Int @id @default(autoincrement()) email String @unique username String @unique passwordHash String fullName String roleId Int active Boolean @default(true) createdAt DateTime @default(now()) role Role @relation(fields:[roleId], references:[id]) auditLogs AuditLog[] }
model Role { id Int @id @default(autoincrement()) name String @unique users User[] permissions Permission[] }
model Permission { id Int @id @default(autoincrement()) action String entity String roleId Int role Role @relation(fields:[roleId], references:[id]) @@unique([action,entity,roleId]) }
model Company { id Int @id @default(1) logoPath String? raisonSociale String @default("EURL SELKA C.M.E") formeJuridique String? activite String @default("COMMERCE MULTIPLE ET ENTREPRISES") adresse String? wilaya String? commune String? telephone String? email String? siteWeb String? nif String? nis String? rc String? articleImposition String? rib String? banque String? fiscalRegime String @default("Régime réel") updatedAt DateTime @updatedAt }
model Client { id Int @id @default(autoincrement()) code String @unique type String name String firstName String? adresse String? wilaya String? commune String? telephone String? email String? nif String? nis String? rc String? articleImposition String? nin String? paymentTerms String? notes String? archived Boolean @default(false) createdAt DateTime @default(now()) invoices Invoice[] quotes Quote[] payments Payment[] creditNotes CreditNote[] purchaseOrders PurchaseOrder[] deliveryNotes DeliveryNote[] @@index([name,nif,code]) }
model Category { id Int @id @default(autoincrement()) name String @unique products Product[] }
model Product { id Int @id @default(autoincrement()) reference String @unique designation String description String? categoryId Int? type String @default("Produit") unit String @default("U") priceHt Decimal @default(0) vatRate Decimal @default(19) priceTtc Decimal @default(0) stock Decimal @default(0) alertThreshold Decimal @default(0) barcode String? notes String? archived Boolean @default(false) category Category? @relation(fields:[categoryId], references:[id]) invoiceItems InvoiceItem[] quoteItems QuoteItem[] purchaseOrderItems PurchaseOrderItem[] deliveryNoteItems DeliveryNoteItem[] creditNoteItems CreditNoteItem[] @@index([designation,reference]) }
model Invoice { id Int @id @default(autoincrement()) number String @unique date DateTime dueDate DateTime? clientId Int status String @default("Brouillon") totalHt Decimal @default(0) discountTotal Decimal @default(0) vatTotal Decimal @default(0) stamp Decimal @default(0) totalTtc Decimal @default(0) paid Decimal @default(0) remaining Decimal @default(0) amountWords String? archived Boolean @default(false) createdAt DateTime @default(now()) client Client @relation(fields:[clientId], references:[id]) items InvoiceItem[] payments Payment[] creditNotes CreditNote[] @@index([date,status]) }
model InvoiceItem { id Int @id @default(autoincrement()) invoiceId Int productId Int? reference String? designation String quantity Decimal unit String priceHt Decimal discountRate Decimal @default(0) vatRate Decimal @default(0) totalHt Decimal vatAmount Decimal totalTtc Decimal invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade) product Product? @relation(fields:[productId], references:[id]) }
model Payment { id Int @id @default(autoincrement()) invoiceId Int clientId Int date DateTime @default(now()) amount Decimal mode String reference String? banque String? notes String? invoice Invoice @relation(fields:[invoiceId], references:[id]) client Client @relation(fields:[clientId], references:[id]) @@index([date,mode]) }
model Quote { id Int @id @default(autoincrement()) number String @unique date DateTime validUntil DateTime? clientId Int status String @default("Brouillon") totalHt Decimal @default(0) vatTotal Decimal @default(0) totalTtc Decimal @default(0) client Client @relation(fields:[clientId], references:[id]) items QuoteItem[] purchaseOrders PurchaseOrder[] }
model QuoteItem { id Int @id @default(autoincrement()) quoteId Int productId Int? reference String? designation String quantity Decimal unit String priceHt Decimal discountRate Decimal @default(0) vatRate Decimal @default(0) totalHt Decimal vatAmount Decimal totalTtc Decimal quote Quote @relation(fields:[quoteId], references:[id], onDelete:Cascade) product Product? @relation(fields:[productId], references:[id]) }
model PurchaseOrder { id Int @id @default(autoincrement()) number String @unique date DateTime clientId Int quoteId Int? status String @default("Brouillon") totalHt Decimal @default(0) vatTotal Decimal @default(0) totalTtc Decimal @default(0) client Client @relation(fields:[clientId], references:[id]) quote Quote? @relation(fields:[quoteId], references:[id]) items PurchaseOrderItem[] deliveryNotes DeliveryNote[] }
model PurchaseOrderItem { id Int @id @default(autoincrement()) purchaseOrderId Int productId Int? reference String? designation String quantity Decimal unit String priceHt Decimal discountRate Decimal @default(0) vatRate Decimal @default(0) totalHt Decimal vatAmount Decimal totalTtc Decimal purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId], references:[id], onDelete:Cascade) product Product? @relation(fields:[productId], references:[id]) }
model DeliveryNote { id Int @id @default(autoincrement()) number String @unique date DateTime clientId Int purchaseOrderId Int? observations String? signature String? status String @default("Brouillon") client Client @relation(fields:[clientId], references:[id]) purchaseOrder PurchaseOrder? @relation(fields:[purchaseOrderId], references:[id]) items DeliveryNoteItem[] }
model DeliveryNoteItem { id Int @id @default(autoincrement()) deliveryNoteId Int productId Int? reference String? designation String quantity Decimal unit String deliveryNote DeliveryNote @relation(fields:[deliveryNoteId], references:[id], onDelete:Cascade) product Product? @relation(fields:[productId], references:[id]) }
model CreditNote { id Int @id @default(autoincrement()) number String @unique date DateTime clientId Int invoiceId Int? reason String status String @default("Validée") totalHt Decimal @default(0) vatTotal Decimal @default(0) totalTtc Decimal @default(0) client Client @relation(fields:[clientId], references:[id]) invoice Invoice? @relation(fields:[invoiceId], references:[id]) items CreditNoteItem[] }
model CreditNoteItem { id Int @id @default(autoincrement()) creditNoteId Int productId Int? reference String? designation String quantity Decimal unit String priceHt Decimal vatRate Decimal @default(0) totalHt Decimal vatAmount Decimal totalTtc Decimal creditNote CreditNote @relation(fields:[creditNoteId], references:[id], onDelete:Cascade) product Product? @relation(fields:[productId], references:[id]) }
model Setting { id Int @id @default(autoincrement()) key String @unique value String group String }
model NumberSeries { id Int @id @default(autoincrement()) code String @unique prefix String year Int counter Int @default(0) length Int @default(5) }
model AuditLog { id Int @id @default(autoincrement()) userId Int? action String entity String entityId String? details String? createdAt DateTime @default(now()) user User? @relation(fields:[userId], references:[id]) @@index([action,entity,createdAt]) }
